flowchart TB
  subgraph CP["Control plane network"]
    KC[Keycloak]
    BR[Broker + BAF issuer]
    JW[JWKS HTTPS]
    BR -->|OIDC| KC
    BR --> JW
  end
  subgraph Host["Ubuntu 24.04 VDI host"]
    XR[xrdp.service]
    SM[xrdp-sesman.service]
    SE[xrdp-sesexec]
    RP[(Replay cache)]
    NS[System NSS]
    PAM[PAM + pam_systemd]
    DESK[Desktop session]
    XR --> SM --> SE
    SE --> RP
    SE --> NS
    SE --> PAM --> NS
    SE --> DESK
  end
  CL[FreeRDP / RDP client] -->|TLS 3389| XR
  BR -->|assertion via client| CL
  SE -. configured HTTPS .-> JW
