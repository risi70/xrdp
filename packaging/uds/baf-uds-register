#!/usr/bin/env python3
"""Register a broker-issued BAF assertion with the trusted Handle service."""

from __future__ import annotations

import argparse
import json
import os
import sys
from pathlib import Path

LIB = Path(__file__).resolve().parent
sys.path.insert(0, str(LIB))
import baf_handle_client


def parser() -> argparse.ArgumentParser:
    result = argparse.ArgumentParser(description=__doc__)
    result.add_argument(
        "--socket", default="/run/xrdp/baf-handle.sock",
        help="trusted local or protected-forwarded Handle service socket",
    )
    result.add_argument("--target", required=True, help="BAF target identifier")
    result.add_argument("--ttl", type=int, default=90, help="Handle TTL (1-120)")
    result.add_argument(
        "--assertion-fd", type=int, default=0,
        help="descriptor containing the broker-issued BAF assertion (default: stdin)",
    )
    result.add_argument(
        "--format", choices=("handle", "cookie", "json"), default="handle",
    )
    return result


def read_assertion(fd: int) -> bytes:
    if fd < 0:
        raise ValueError("assertion descriptor must be non-negative")
    with os.fdopen(fd, "rb", closefd=False) as stream:
        assertion = stream.read(baf_handle_client.MAX_ASSERTION + 1).strip()
    if not assertion:
        raise ValueError("assertion descriptor was empty")
    if len(assertion) > baf_handle_client.MAX_ASSERTION:
        raise ValueError("assertion exceeds protocol limit")
    return assertion


def main(argv: list[str] | None = None) -> int:
    args = parser().parse_args(argv)
    if not 1 <= args.ttl <= 120:
        parser().error("--ttl must be between 1 and 120")

    try:
        assertion = read_assertion(args.assertion_fd)
        handle = baf_handle_client.store(
            args.socket, assertion, args.target, args.ttl
        )
    except (OSError, ValueError, baf_handle_client.HandleError) as exc:
        print(f"Handle registration failed: {exc}", file=sys.stderr)
        return 1

    if args.format == "cookie":
        print(f"Cookie: msts={handle}")
    elif args.format == "json":
        print(json.dumps({"handle": handle, "target": args.target}))
    else:
        print(handle)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
