#!/bin/sh
set -e

if ! getent group xrdp >/dev/null; then
    addgroup --system xrdp >/dev/null
fi

umask 077
if [ ! -f /etc/xrdp/rsakeys.ini ]; then
    /usr/bin/xrdp-keygen xrdp /etc/xrdp/rsakeys.ini >/dev/null
fi
if [ ! -f /etc/xrdp/key.pem ]; then
    /usr/bin/openssl req -x509 -newkey rsa:2048 -sha256 -nodes \
        -keyout /etc/xrdp/key.pem -out /etc/xrdp/cert.pem -days 365 \
        -subj /CN=xrdp-local >/dev/null 2>&1
elif [ ! -f /etc/xrdp/cert.pem ]; then
    /usr/bin/openssl req -x509 -new -sha256 \
        -key /etc/xrdp/key.pem -out /etc/xrdp/cert.pem -days 365 \
        -subj /CN=xrdp-local >/dev/null 2>&1
fi

# On Debian/Ubuntu the bare "Xorg" resolves to the setuid /usr/bin/Xorg.wrap,
# which sesman cannot launch for a session, so graphical startup fails. Point
# the [Xorg] server at the non-suid binary when the packaged default is still
# in place. Operator-edited values are left untouched (conffile-safe).
if [ -f /etc/xrdp/sesman.ini ] \
        && grep -qxF 'param=Xorg' /etc/xrdp/sesman.ini; then
    for xorg_bin in /usr/lib/xorg/Xorg /usr/libexec/Xorg /usr/lib/Xorg; do
        [ -x "$xorg_bin" ] || continue
        sed -i "/^\[Xorg\]/,/^\[/ s|^param=Xorg\$|param=$xorg_bin|" \
            /etc/xrdp/sesman.ini
        printf 'Selected non-suid X server: %s\n' "$xorg_bin"
        break
    done
fi

if command -v systemctl >/dev/null 2>&1; then
    systemctl daemon-reload >/dev/null 2>&1 || true
fi

printf '%s\n' \
    'xrdp-baf installed with broker authentication disabled.' \
    'Review DEPLOYMENT-KEYCLOAK-BAF-XRDP.md before enabling BAF services.'

exit 0
