#!/bin/sh
set -e

if ! getent group xrdp >/dev/null; then
    addgroup --system xrdp >/dev/null
fi

if command -v systemctl >/dev/null 2>&1; then
    systemctl daemon-reload >/dev/null 2>&1 || true
fi

printf '%s\n' \
    'xrdp-baf installed with broker authentication disabled.' \
    'Review DEPLOYMENT-KEYCLOAK-BAF-XRDP.md before enabling BAF services.'

exit 0
