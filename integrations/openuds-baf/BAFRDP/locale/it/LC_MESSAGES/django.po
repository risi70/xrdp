# BAF RDP transport portal strings.
# Regenerate with tools/update-locales.py after editing
# transport.py; msgids are extracted from the source.
msgid ""
msgstr ""
"Project-Id-Version: xrdp-baf-openuds\n"
"Language: it\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "BAF Broker"
msgstr "Broker BAF"

msgid "The desktop service is not configured correctly. Please contact your administrator."
msgstr "Il servizio desktop non è configurato correttamente. Contattare l'amministratore."

msgid "The sign-on service is temporarily unavailable. Please try again in a moment."
msgstr "Il servizio di accesso è temporaneamente non disponibile. Riprovare tra qualche istante."

msgid "You are not authorized to open this desktop."
msgstr "Non si è autorizzati ad aprire questo desktop."

msgid "The desktop could not be prepared for your session. Please try again or contact your administrator."
msgstr "Non è stato possibile preparare il desktop per la sessione. Riprovare o contattare l'amministratore."

msgid "The requested desktop is not available."
msgstr "Il desktop richiesto non è disponibile."

msgid "An unexpected error occurred while starting your desktop."
msgstr "Si è verificato un errore imprevisto durante l'avvio del desktop."

msgid "RDP (BAF broker)"
msgstr "RDP (broker BAF)"

msgid "RDP protected by the XRDP Broker Authentication Framework: single-use handles issued by a trusted broker replace passwords."
msgstr "RDP protetto dal Broker Authentication Framework di XRDP: handle monouso emessi da un broker fidato sostituiscono le password."

msgid "Broker issuance URL"
msgstr "URL di emissione del broker"

msgid "HTTPS endpoint of the trusted BAF broker issuance API"
msgstr "Endpoint HTTPS dell'API di emissione del broker BAF fidato"

msgid "Broker CA bundle"
msgstr "Bundle CA del broker"

msgid "Path to the CA bundle that authenticates the broker"
msgstr "Percorso del bundle CA che autentica il broker"

msgid "Client certificate"
msgstr "Certificato client"

msgid "Path to this server's mutual-TLS client certificate"
msgstr "Percorso del certificato client mutual-TLS di questo server"

msgid "Client private key"
msgstr "Chiave privata del client"

msgid "Path to this server's mutual-TLS private key"
msgstr "Percorso della chiave privata mutual-TLS di questo server"

msgid "Handle registration backend"
msgstr "Backend di registrazione degli handle"

msgid "How the assertion is registered with the desktop host"
msgstr "Come l'asserzione viene registrata presso l'host desktop"

msgid "SSH identity file"
msgstr "File di identità SSH"

msgid "Dedicated private key for the registration account; pair it with a forced command on the desktop host"
msgstr "Chiave privata dedicata all'account di registrazione; da abbinare a un comando forzato sull'host desktop"

msgid "SSH known_hosts file"
msgstr "File known_hosts SSH"

msgid "Pinned host keys of the desktop hosts"
msgstr "Chiavi host fissate degli host desktop"

msgid "SSH user"
msgstr "Utente SSH"

msgid "Registration account on the desktop host"
msgstr "Account di registrazione sull'host desktop"

msgid "Handle socket path"
msgstr "Percorso del socket degli handle"

msgid "Handle service socket for the socket backend"
msgstr "Socket del servizio handle per il backend socket"

msgid "Ingress channel"
msgstr "Canale di ingresso"

msgid "How the single-use handle reaches the desktop host"
msgstr "Come l'handle monouso raggiunge l'host desktop"

msgid "Handle lifetime (seconds)"
msgstr "Durata dell'handle (secondi)"

msgid "Validity window of the single-use handle (1-120)"
msgstr "Finestra di validità dell'handle monouso (1-120)"

msgid "Fixed BAF target"
msgstr "Destinazione BAF fissa"

msgid "Optional fixed target identifier; when empty the machine name of the assigned desktop is used"
msgstr "Identificatore di destinazione fisso facoltativo; se vuoto viene usato il nome macchina del desktop assegnato"

msgid "SSH to the desktop host"
msgstr "SSH verso l'host desktop"

msgid "Local or forwarded socket"
msgstr "Socket locale o inoltrato"

msgid "One-time credential (password field)"
msgstr "Credenziale monouso (campo password)"

msgid "Routing token (load-balance-info)"
msgstr "Token di instradamento (load-balance-info)"
