[Unit]
Description=BAF assertion issuance service (broker-to-XRDP connector)
Documentation=file:/usr/share/doc/xrdp-baf/BROKER-SERVICE.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=baf-issuer
Group=baf-issuer
ExecStart=/usr/bin/python3 /opt/xrdp-baf/baf_issuance_service.py \
    --config /etc/xrdp-baf/issuanced/config
Restart=on-failure
RestartSec=2

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
ReadOnlyPaths=/etc/xrdp-baf/issuanced

[Install]
WantedBy=multi-user.target
